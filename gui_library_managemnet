    def _book_form_dialog(self, title, data=None):
        dlg = tk.Toplevel(self)
        dlg.title(title)
        dlg.configure(bg=CARD)
        dlg.resizable(False, False)
        dlg.grab_set()
        w, h = 440, 420
        dlg.geometry(f"{w}x{h}+{self.winfo_x()+350}+{self.winfo_y()+150}")

        label(dlg, title, font=FONT_H2).pack(pady=(20,10))

        fields = [("Title*", "title"), ("Author*", "author"), ("ISBN", "isbn"),
                  ("Genre", "genre"), ("Year", "year"), ("Copies", "copies")]
        vars_ = {}
        form = tk.Frame(dlg, bg=CARD)
        form.pack(padx=30, fill="x")
        for i, (lbl, key) in enumerate(fields):
            tk.Label(form, text=lbl, bg=CARD, fg=SUBTEXT, font=FONT_SM).grid(
                row=i, column=0, sticky="w", pady=5)
            v = tk.StringVar()
            if data:
                v.set(data[i+1] if data[i+1] is not None else "")
            entry_field(form, v, 26).grid(row=i, column=1, padx=(10,0), sticky="ew")
            vars_[key] = v

        def save():
            t = vars_["title"].get().strip()
            a = vars_["author"].get().strip()
            if not t or not a:
                messagebox.showwarning("Required", "Title and Author are required.", parent=dlg)
                return
            try:
                year = int(vars_["year"].get()) if vars_["year"].get() else None
                copies = int(vars_["copies"].get()) if vars_["copies"].get() else 1
            except ValueError:
                messagebox.showwarning("Invalid", "Year and Copies must be numbers.", parent=dlg)
                return
            conn = get_conn(); c = conn.cursor()
            if data:
                c.execute("""UPDATE books SET title=?,author=?,isbn=?,genre=?,
                             year=?,copies=?,available=? WHERE id=?""",
                          (t, a, vars_["isbn"].get() or None,
                           vars_["genre"].get() or None, year, copies,
                           min(copies, data[7]), data[0]))
            else:
                c.execute("""INSERT INTO books (title,author,isbn,genre,year,copies,available)
                             VALUES (?,?,?,?,?,?,?)""",
                          (t, a, vars_["isbn"].get() or None,
                           vars_["genre"].get() or None, year, copies, copies))
            conn.commit(); conn.close()
            dlg.destroy()
            self._refresh_books("")

        styled_btn(dlg, "💾  Save", save).pack(pady=18)

    def _delete_book(self, book_id):
        if messagebox.askyesno("Confirm", "Delete this book permanently?"):
            conn = get_conn()
            conn.execute("DELETE FROM books WHERE id=?", (book_id,))
            conn.commit(); conn.close()
            self._refresh_books("")

                                                                                 

