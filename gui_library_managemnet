    def _refresh_members(self, q=""):
        tree = self._members_tree
        for row in tree.get_children(): tree.delete(row)
        conn = get_conn()
        sql = """
            SELECT m.id,m.name,m.email,m.phone,m.joined,
                   COUNT(i.id) as active
            FROM members m
            LEFT JOIN issues i ON i.member_id=m.id AND i.return_date IS NULL
        """
        if q and q != "Search members…":
            rows = conn.execute(sql + " WHERE m.name LIKE ? OR m.email LIKE ?"
                                " GROUP BY m.id", (f"%{q}%",)*2).fetchall()
        else:
            rows = conn.execute(sql + " GROUP BY m.id").fetchall()
        conn.close()
        for idx, r in enumerate(rows):
            tag = "odd" if idx%2==0 else "even"
            tree.insert("", "end",
                        values=(r[0], r[1], r[2] or "—", r[3] or "—", r[4], r[5]),
                        tags=(tag,))

