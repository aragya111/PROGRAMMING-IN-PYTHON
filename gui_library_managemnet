            ("📖  Books",      "books",      self._page_books),
            ("👤  Members",    "members",    self._page_members),
            ("🔄  Issue/Return","issues",    self._page_issues),
            ("📋  History",    "history",    self._page_history),
        ]

        self._nav_buttons = {}
        for label_txt, key, builder in nav_items:
            btn = tk.Button(
                sidebar, text=label_txt, anchor="w",
                font=FONT_NAV, relief="flat", cursor="hand2",
                bg=SIDEBAR, fg=SUBTEXT, padx=20, pady=12,
                command=lambda k=key, b=builder: self._show_page(k, b)
            )
            btn.pack(fill="x")
            btn.bind("<Enter>", lambda e, b=btn: b.config(fg=TEXT, bg=BORDER))
            btn.bind("<Leave>", lambda e, b=btn, k=key: (
                b.config(fg=TEXT if self._active==k else SUBTEXT,
                         bg=ACCENT if self._active==k else SIDEBAR)))
            self._nav_buttons[key] = btn

        self._active = ""
        self._show_page("dashboard", self._page_dashboard)

    def _show_page(self, key, builder):
        for w in self.content.winfo_children():
            w.destroy()
        self.pages.clear()

        if self._active and self._active in self._nav_buttons:
            self._nav_buttons[self._active].config(bg=SIDEBAR, fg=SUBTEXT)
        self._active = key
        self._nav_buttons[key].config(bg=ACCENT, fg=BG)
        builder()

                                                                                

