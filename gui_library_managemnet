    def _refresh_books(self, q=""):
        tree = self._books_tree
        for row in tree.get_children():
            tree.delete(row)
        conn = get_conn()
        if q and q != "Search books…":
            rows = conn.execute(
                "SELECT id,title,author,genre,year,copies,available FROM books "
                "WHERE title LIKE ? OR author LIKE ? OR genre LIKE ?",
                (f"%{q}%",)*3
            ).fetchall()
        else:
            rows = conn.execute(
                "SELECT id,title,author,genre,year,copies,available FROM books"
            ).fetchall()
        conn.close()
        for idx, r in enumerate(rows):
            tag = "odd" if idx%2==0 else "even"
            tree.insert("", "end",
                        values=(r[0], r[1], r[2], r[3] or "—", r[4] or "—",
                                r[5], r[6], "Edit | Delete"),
                        tags=(tag,))

    def _book_row_action(self, event):
        tree = self._books_tree
        item = tree.focus()
        if not item: return
        col = tree.identify_column(event.x)
        vals = tree.item(item)["values"]
        book_id = vals[0]
        if col == "#8":                  
            x = event.x_root; y = event.y_root
            menu = tk.Menu(self, tearoff=0, bg=CARD, fg=TEXT,
                           activebackground=ACCENT, activeforeground=BG)
            menu.add_command(label="✏️  Edit",   command=lambda: self._edit_book_dialog(book_id))
            menu.add_command(label="🗑  Delete", command=lambda: self._delete_book(book_id))
            menu.post(x, y)

