        conn = get_conn()
        books_avail = conn.execute(
            "SELECT id, title FROM books WHERE available > 0").fetchall()
        members_all = conn.execute(
            "SELECT id, name FROM members").fetchall()
        conn.close()

        book_opts   = [f"[{r[0]}] {r[1]}" for r in books_avail]
        member_opts = [f"[{r[0]}] {r[1]}" for r in members_all]

        self._issue_book_var   = tk.StringVar()
        self._issue_member_var = tk.StringVar()
        self._issue_days_var   = tk.StringVar(value="14")

        for lbl_txt, var, opts in [
            ("Book", self._issue_book_var, book_opts),
            ("Member", self._issue_member_var, member_opts),
        ]:
            tk.Label(issue_card, text=lbl_txt, bg=CARD, fg=SUBTEXT, font=FONT_SM).pack(anchor="w")
            combo_field(issue_card, opts, var, 34).pack(anchor="w", pady=(2,10))

        tk.Label(issue_card, text="Loan Days", bg=CARD, fg=SUBTEXT, font=FONT_SM).pack(anchor="w")
        entry_field(issue_card, self._issue_days_var, 10).pack(anchor="w", pady=(2,14))
        styled_btn(issue_card, "📤  Issue Book", self._issue_book, ACCENT2, BG).pack(anchor="w")

                            
        ret_card = card_frame(cols_frame, padx=24, pady=20)
        ret_card.pack(side="right", fill="both", expand=True, padx=(10,0))
        label(ret_card, "📥  Return Book", font=FONT_H2).pack(anchor="w", pady=(0,12))

        conn = get_conn()
        active = conn.execute("""
            SELECT i.id, b.title, m.name, i.due_date
            FROM issues i
            JOIN books b ON b.id=i.book_id
            JOIN members m ON m.id=i.member_id
            WHERE i.return_date IS NULL
            ORDER BY i.due_date
        """).fetchall()
        conn.close()

        ret_opts = [f"[{r[0]}] {r[1]} — {r[2]} (due {r[3]})" for r in active]
        self._return_issue_var = tk.StringVar()
        tk.Label(ret_card, text="Active Issue", bg=CARD, fg=SUBTEXT, font=FONT_SM).pack(anchor="w")
        combo_field(ret_card, ret_opts, self._return_issue_var, 38).pack(anchor="w", pady=(2,14))
        styled_btn(ret_card, "📥  Record Return", self._return_book, ACCENT, TEXT).pack(anchor="w")

    def _issue_book(self):
        b = self._issue_book_var.get()
        m = self._issue_member_var.get()
        d = self._issue_days_var.get()
        if not b or not m:
            messagebox.showwarning("Select", "Please select a book and a member."); return
        try: days = int(d)
        except: days = 14
        book_id   = int(b.split("]")[0][1:])
        member_id = int(m.split("]")[0][1:])
        due = (datetime.now() + timedelta(days=days)).strftime("%Y-%m-%d")
        conn = get_conn(); c = conn.cursor()
        c.execute("INSERT INTO issues (book_id,member_id,due_date) VALUES (?,?,?)",
                  (book_id, member_id, due))
        c.execute("UPDATE books SET available=available-1 WHERE id=?", (book_id,))
        conn.commit(); conn.close()
        messagebox.showinfo("Success", f"Book issued! Due: {due}")
        self._show_page("issues", self._page_issues)

    def _return_book(self):
        sel = self._return_issue_var.get()
        if not sel:
            messagebox.showwarning("Select", "Please select an issue to return."); return
        issue_id = int(sel.split("]")[0][1:])
        conn = get_conn(); c = conn.cursor()
        r = c.execute("SELECT book_id FROM issues WHERE id=?", (issue_id,)).fetchone()
        if r:
            c.execute("UPDATE issues SET return_date=date('now') WHERE id=?", (issue_id,))
            c.execute("UPDATE books SET available=available+1 WHERE id=?", (r[0],))
            conn.commit()
        conn.close()
        messagebox.showinfo("Success", "Book returned successfully!")
        self._show_page("issues", self._page_issues)

                                                                                 

    def _page_history(self):
        page = tk.Frame(self.content, bg=BG)
        page.pack(fill="both", expand=True, padx=30, pady=20)

        hdr = tk.Frame(page, bg=BG); hdr.pack(fill="x")
        label(hdr, "Issue History", font=FONT_H1).pack(side="left")

        sf = tk.Frame(page, bg=BG); sf.pack(fill="x", pady=10)
        self._hist_filter = tk.StringVar()
        fo = combo_field(sf, ["All", "Active", "Returned", "Overdue"], self._hist_filter, 14)
        fo.set("All"); fo.pack(side="left")
        styled_btn(sf, "Filter", lambda: self._refresh_history(self._hist_filter.get()),
                   ACCENT2, BG).pack(side="left", padx=8)

        cols = ("#", "Book", "Member", "Issued", "Due", "Returned", "Status")
        widths = (40, 230, 150, 100, 100, 100, 90)
        self._history_tree = build_tree(page, cols, widths)
        self._refresh_history("All")

    def _refresh_history(self, filt="All"):
        tree = self._history_tree
        for r in tree.get_children(): tree.delete(r)
        conn = get_conn()
        rows = conn.execute("""
            SELECT i.id, b.title, m.name, i.issue_date, i.due_date, i.return_date
            FROM issues i
            JOIN books b ON b.id=i.book_id
            JOIN members m ON m.id=i.member_id
            ORDER BY i.id DESC
        """).fetchall()
        conn.close()
        today = datetime.now().strftime("%Y-%m-%d")
        for idx, r in enumerate(rows):
            status = ("Returned" if r[5] else
                      ("Overdue"  if r[4] and r[4] < today else "Active"))
            if filt == "Active"   and status != "Active":   continue
            if filt == "Returned" and status != "Returned": continue
            if filt == "Overdue"  and status != "Overdue":  continue
            tag = "odd" if idx%2==0 else "even"
            tree.insert("", "end",
                        values=(r[0], r[1], r[2], r[3], r[4] or "—",
                                r[5] or "—", status),
                        tags=(tag,))

                                                                                

